# --- Base de donnees ---
# Par defaut : Postgres lance via docker-compose (voir README a la racine du projet)
DATABASE_URL=postgresql+psycopg2://callback:callback@localhost:5432/callback

# --- Authentification ---
# Cle secrete utilisee pour signer les tokens JWT de connexion.
# IMPORTANT : change cette valeur avant de deployer en production (ex: openssl rand -hex 32).
JWT_SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
# Duree de validite d'un token, en minutes (par defaut 7 jours)
JWT_EXPIRE_MINUTES=10080

# --- Fournisseur LLM ---
# "mock"   : aucune dependance externe, reponses simulees par mots-cles (par defaut, pour demarrer
#            tout de suite) -- ATTENTION : la liste de competences reconnues est biaisee web/fullstack,
#            donc les questions restent generiques pour un CV/une offre dans un autre domaine (data,
#            mecanique...). Pour de vraies questions adaptees a n'importe quel domaine, utilise "gemini".
# "gemini" : utilise l'API Gemini standard (gratuite avec une cle perso, meme cle que le mode vocal) --
#            vraie comprehension du CV/de l'offre, quel que soit le domaine.
# "ollama" : utilise un modele local via Ollama (gratuit, tourne sur ta machine)
# "openai" : utilise l'API OpenAI (necessite une cle, facturee a l'usage)
LLM_PROVIDER=mock

# Utilise seulement si LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

# Utilise seulement si LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Entretien vocal (V2, Gemini Live) + LLM_PROVIDER=gemini ---
# Cle gratuite : https://aistudio.google.com -> "Get API key"
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Utilises seulement si LLM_PROVIDER=gemini (extraction CV/offre + generation des questions)
GEMINI_TEXT_MODEL=gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-001
# Voix disponibles cote Gemini Live : Puck, Charon, Kore, Fenrir, Aoede (a ajuster si besoin)
GEMINI_VOICE_MAP_CLAIRE=Aoede
GEMINI_VOICE_MAP_MARC=Charon
GEMINI_VOICE_MAP_LEA=Kore
GEMINI_VOICE_MAP_HUGO=Puck

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173
